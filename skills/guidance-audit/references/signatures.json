{
  "_about": "Mechanical compliance signatures for common generic directives. A signature is a regex whose count in generated output indicates whether the directive was followed. Signatures need not be perfectly accurate -- the audit DIFFERENCES two arms, so any bias applies equally to both and cancels. What matters is that a signature responds to the directive.",
  "_measured": {
    "date": "2026-09-07",
    "models": [
      "gpt-5.6-luna",
      "gpt-5.6-terra"
    ],
    "task_family": "self-contained front-end HTML builds",
    "note": "The `observed` field records which bucket each directive fell into IN THAT SETTING. It is a prior, not a verdict. The audit re-derives buckets on the user's own model and task; treat `observed` as a hint about which lines are worth checking first."
  },
  "signatures": [
    {
      "id": "reduced-motion",
      "keywords": [
        "prefers-reduced-motion",
        "reduced motion",
        "respect motion"
      ],
      "regex": "prefers-reduced-motion",
      "observed": "only-when-asked",
      "note": "0 of 12 files without the directive, 12 of 12 with it. The strongest only-when-asked signal measured."
    },
    {
      "id": "aria-attributes",
      "keywords": [
        "aria-label",
        "aria-labelledby",
        "assistive technology",
        "screen reader"
      ],
      "regex": "\\saria-[a-z]+=",
      "observed": "only-when-asked",
      "note": "Rises ~2x absolute, ~1.25-1.35x per KB. Partly a size effect; check density."
    },
    {
      "id": "aria-live",
      "keywords": [
        "aria-live",
        "announce dynamic",
        "live region"
      ],
      "regex": "aria-live",
      "observed": "mixed"
    },
    {
      "id": "rem-units",
      "keywords": [
        "rem unit",
        "prefer rem",
        "use rem",
        "rem for typography",
        "scales with user"
      ],
      "regex": "\\d(\\.\\d+)?rem\\b",
      "observed": "only-when-asked",
      "note": "4-7x by density. Among the clearest genuine adoptions."
    },
    {
      "id": "css-custom-properties",
      "keywords": [
        "custom propert",
        "css variable",
        "design token"
      ],
      "regex": "--[a-z][\\w-]*\\s*:",
      "observed": "only-when-asked"
    },
    {
      "id": "semantic-elements",
      "keywords": [
        "semantic",
        "<main>",
        "<section>",
        "<header>",
        "<footer>",
        "landmark"
      ],
      "regex": "<(main|section|header|footer|nav|article|aside)\\b",
      "observed": "partial"
    },
    {
      "id": "form-labels",
      "keywords": [
        "<label>",
        "associated label",
        "form control needs",
        "label for every"
      ],
      "regex": "<label\\b",
      "observed": "task-dependent"
    },
    {
      "id": "focus-visible",
      "keywords": [
        "focus indicator",
        "focus-visible",
        "keyboard focus",
        "visible focus"
      ],
      "regex": ":focus(-visible)?\\s*[,{]",
      "observed": "task-dependent"
    },
    {
      "id": "modern-declarations",
      "keywords": [
        "const and let",
        "use const",
        "rather than var",
        "prefer const"
      ],
      "regex": "\\b(const|let)\\s",
      "observed": "already-followed",
      "note": "Present without the directive in every file measured; `var` never appeared."
    },
    {
      "id": "no-var",
      "keywords": [
        "avoid var",
        "never use var",
        "no var",
        "rather than var"
      ],
      "regex": "\\bvar\\s",
      "observed": "already-followed",
      "inverted": true,
      "note": "Inverted: a compliant file has ZERO matches."
    },
    {
      "id": "event-listeners",
      "keywords": [
        "addeventlistener",
        "inline handler",
        "onclick attribute"
      ],
      "regex": "addEventListener\\(",
      "observed": "already-followed"
    },
    {
      "id": "no-inline-handlers",
      "keywords": [
        "inline event",
        "onclick=",
        "no inline handler"
      ],
      "regex": "\\son[a-z]+\\s*=\\s*[\"']",
      "observed": "already-followed",
      "inverted": true,
      "note": "Inverted: a compliant file has ZERO matches."
    },
    {
      "id": "code-comments",
      "keywords": [
        "comment",
        "document non-obvious",
        "explain why"
      ],
      "regex": "^\\s*//|/\\*",
      "observed": "ignored",
      "note": "Zero comments in all 48 files measured, with and without the directive."
    },
    {
      "id": "error-handling",
      "keywords": [
        "try",
        "catch",
        "fail gracefully",
        "handle errors",
        "error handling"
      ],
      "regex": "\\bcatch\\s*\\(",
      "observed": "ignored",
      "note": "Zero try/catch in all 48 files measured, with and without the directive."
    },
    {
      "id": "debounce",
      "keywords": [
        "debounce",
        "throttle",
        "frequent event"
      ],
      "regex": "debounce|throttle",
      "observed": "ignored"
    },
    {
      "id": "no-innerhtml",
      "keywords": [
        "innerhtml",
        "createElement",
        "textContent"
      ],
      "regex": "\\.innerHTML\\s*=",
      "observed": "task-dependent",
      "inverted": true
    },
    {
      "id": "responsive",
      "keywords": [
        "responsive",
        "media query",
        "narrow viewport",
        "mobile"
      ],
      "regex": "@media",
      "observed": "partial"
    },
    {
      "id": "flex-grid",
      "keywords": [
        "flexbox",
        "css grid",
        "modern layout method",
        "rather than floats"
      ],
      "regex": "display\\s*:\\s*(flex|grid)",
      "observed": "already-followed"
    },
    {
      "id": "no-important",
      "keywords": [
        "!important",
        "specificity"
      ],
      "regex": "!important",
      "observed": "already-followed",
      "inverted": true
    }
  ]
}